#: core/templates/base.html:7 core/templates/base.html:15
msgid "Playworks North is a Montreal studio making games and apps."
msgstr ""
"Playworks North est un studio montréalais qui crée des jeux et des "
"applications."

#: core/templates/base.html:26
msgid "Language"
msgstr "Langue"

#: core/templates/base.html:35
msgid "Playworks North Studio"
msgstr "Studio Playworks North"

#: core/templates/base.html:35
msgid "Montreal"
msgstr "Montréal"

#: core/templates/core/home.html:5
msgid "Games and apps, made in Montreal."
msgstr "Des jeux et des applications, faits à Montréal."

#: core/templates/core/home.html:6
msgid ""
"Playworks North is a studio building games and apps that are fun to play and "
"pleasant to use, and we ship them. Available for contract and collaboration "
"work."
msgstr ""
"Playworks North est un studio qui crée des jeux et des applications amusants "
"à jouer et agréables à utiliser, et qui les livre. Disponible pour des "
"contrats et des collaborations."

#: core/templates/core/home.html:10
msgid "Edouard Murat, founder of Playworks North"
msgstr "Edouard Murat, fondateur de Playworks North"

#: core/templates/core/home.html:12
msgid "Who builds this"
msgstr "Qui est derrière le studio"

#: core/templates/core/home.html:13
msgid ""
"Playworks North is run by Edouard Murat, a Montreal-based developer who "
"builds and ships every project on this page."
msgstr ""
"Playworks North est dirigé par Edouard Murat, un développeur montréalais qui "
"crée et livre chacun des projets de cette page."

#: core/templates/core/home.html:18
msgid "Projects"
msgstr "Projets"

#: core/templates/core/home.html:37
msgid "Contact"
msgstr "Contact"

#: core/templates/core/home.html:62
msgid "Send"
msgstr "Envoyer"

#: core/views.py:18 core/views.py:54
msgid "Game"
msgstr "Jeu"

#: core/views.py:19 core/views.py:37
msgid "Released"
msgstr "Sorti"

#: core/views.py:20
msgid "A word-building puzzle game where you carve new words out of old ones."
msgstr "Un jeu de réflexion où l'on taille de nouveaux mots dans les anciens."

#: core/views.py:27
msgid "App"
msgstr "Application"

#: core/views.py:28 core/views.py:55
msgid "In development"
msgstr "En développement"

#: core/views.py:29
msgid ""
"A voice coach for Apex Legends. It watches your match and calls the play out "
"loud while you play."
msgstr "Un coach vocal pour Apex Legends. Il suit votre partie et annonce le jeu à voix haute pendant que vous jouez."

#: core/views.py:31 core/views.py:49
msgid "Site"
msgstr "Site"

#: core/views.py:36
msgid "Game assets"
msgstr "Ressources de jeu"

#: core/views.py:38
msgid ""
"Isometric pixel art asset packs for game makers, starting with a classroom "
"and a science lab."
msgstr ""
"Des packs de ressources pixel art isométriques pour les créateurs de jeux, à "
"commencer par une salle de classe et un laboratoire."

#: core/views.py:45
msgid "Job board"
msgstr "Offres d'emploi"

#: core/views.py:46
msgid "Live"
msgstr "En ligne"

#: core/views.py:47
msgid ""
"A job board for the Godot game engine community, connecting studios with "
"Godot developers."
msgstr ""
"Un site d'offres d'emploi pour la communauté du moteur de jeu Godot, qui met "
"en relation les studios et les développeurs Godot."

#: core/views.py:56
msgid ""
"A meditation game. You sit still in a neon city for about an hour, then "
"press one key at just the right moment."
msgstr "Un jeu de méditation. Vous restez immobile dans une ville néon pendant environ une heure, puis vous appuyez sur une touche au bon moment."

#: core/views.py:90
#, python-format
msgid "New message from %(name)s via playworksnorth.com"
msgstr "Nouveau message de %(name)s via playworksnorth.com"

#: core/views.py:100
msgid "Thanks, your message is on its way."
msgstr "Merci, votre message est en route."

#: core/views.py:103
msgid "Something went wrong sending your message. Please try again shortly."
msgstr "Une erreur est survenue lors de l'envoi. Veuillez réessayer sous peu."

#: core/views.py:105
msgid "The captcha check failed. Please try again."
msgstr "La vérification anti-robot a échoué. Veuillez réessayer."

#: core/views.py:107
msgid "Please fill in every field and try again."
msgstr "Veuillez remplir tous les champs et réessayer."
